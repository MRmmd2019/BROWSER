name: ⬇️ Media Downloader Pro (yt‑dlp + FFmpeg + aria2)

on:
  workflow_dispatch:
    inputs:
      # -- انتخاب حالت --
      download_mode:
        description: '🎯 حالت دانلود'
        required: true
        type: choice
        default: 'video'
        options:
          - 'video'
          - 'audio'
      url:
        description: '🎬 نشانی رسانه (یوتیوب یا هر سایت پشتیبانی‌شده)'
        required: true
        type: string

      # -- گزینه‌های عمومی --
      socket_timeout:
        description: '⏱️ زمان انتظار برای اتصال (ثانیه)'
        required: false
        type: number
        default: 30
      retries:
        description: '🔄 تعداد تلاش مجدد (۱-۱۰)'
        required: false
        type: number
        default: 3
      fragment_retries:
        description: '🧩 تعداد تلاش مجدد برای هر قطعه (۱-۱۰)'
        required: false
        type: number
        default: 3
      file_access_retries:
        description: '📁 تعداد تلاش مجدد خطای دسترسی به فایل (۱-۱۰)'
        required: false
        type: number
        default: 3
      filename_template:
        description: '📝 الگوی نام فایل خروجی'
        required: false
        type: string
        default: '%(title)s.%(ext)s'

      # -- گزینه‌های ویدیو --
      list_extractors:
        description: '📋 ویدیو: نمایش تمام سایت‌های پشتیبانی‌شده'
        required: false
        type: boolean
        default: false
      write_info_json:
        description: '📄 ویدیو: نوشتن متادیتای ویدیو'
        required: false
        type: boolean
        default: false
      write_description:
        description: '📝 ویدیو: نوشتن توضیحات ویدیو'
        required: false
        type: boolean
        default: false
      write_all_thumbnails:
        description: '🖼️ ویدیو: ذخیره تمام تصاویر بندانگشتی'
        required: false
        type: boolean
        default: false
      format_choice:
        description: '🎬 ویدیو: انتخاب فرمت'
        required: false
        type: choice
        default: 'best'
        options:
          - 'best'
          - 'bestvideo+bestaudio'
          - '1080p (Full HD)'
          - '720p (HD)'
          - '480p'
          - '360p'
          - 'ویدیو MP4 (بهترین کیفیت)'
          - 'ویدیو WebM (بهترین کیفیت)'
          - 'ویدیو MKV (بهترین کیفیت)'
      list_formats:
        description: '📊 ویدیو: نمایش تمام فرمت‌های موجود'
        required: false
        type: boolean
        default: false
      merge_format:
        description: '📦 ویدیو: فرمت ادغام نهایی'
        required: false
        type: choice
        default: 'default'
        options:
          - 'default'
          - 'mp4'
          - 'mkv'
          - 'webm'
          - 'flv'
          - 'ogg'

      # -- گزینه‌های صوت --
      audio_quality:
        description: '🎧 صوت: کیفیت صدا'
        required: false
        type: choice
        default: '0 (best)'
        options:
          - '0 (best)'
          - '320K'
          - '256K'
          - '192K'
          - '128K'
      audio_format:
        description: '🎵 صوت: فرمت صدا'
        required: false
        type: choice
        default: 'mp3'
        options:
          - 'mp3'
          - 'm4a'
          - 'flac'
          - 'wav'
          - 'aac'
          - 'opus'
          - 'ogg'
      embed_thumbnail:
        description: '🖼️ صوت: قرار دادن کاور'
        required: false
        type: boolean
        default: false
      embed_metadata:
        description: '📋 صوت: قرار دادن متادیتا'
        required: false
        type: boolean
        default: false

jobs:
  download:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: 📦 دریافت مخزن
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: 🛠️ نصب yt‑dlp با FFmpeg و aria2
        uses: AnimMouse/setup-yt-dlp@v3
        with:
          ffmpeg: true
          aria2: true

      # ------------------------------------------------------------
      #  ویدیو: نگاشت فرمت
      # ------------------------------------------------------------
      - name: 🗺️ نگاشت گزینه‌های ویدیو
        if: github.event.inputs.download_mode == 'video'
        id: video-mapper
        shell: bash
        run: |
          declare -A MAP=(
            ["best"]="bestvideo*+bestaudio/best"
            ["bestvideo+bestaudio"]="bestvideo+bestaudio/best"
            ["1080p (Full HD)"]="bestvideo[height<=1080]+bestaudio/best[height<=1080]"
            ["720p (HD)"]="bestvideo[height<=720]+bestaudio/best[height<=720]"
            ["480p"]="bestvideo[height<=480]+bestaudio/best[height<=480]"
            ["360p"]="bestvideo[height<=360]+bestaudio/best[height<=360]"
            ["ویدیو MP4 (بهترین کیفیت)"]="bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]"
            ["ویدیو WebM (بهترین کیفیت)"]="bestvideo[ext=webm]+bestaudio[ext=webm]/best[ext=webm]"
            ["ویدیو MKV (بهترین کیفیت)"]="bestvideo[ext=webm]+bestaudio[ext=webm]/best[ext=mkv]"
          )
          CHOICE="${{ github.event.inputs.format_choice }}"
          echo "format=${MAP[$CHOICE]}" >> "$GITHUB_OUTPUT"

          MERGE=""
          if [ "${{ github.event.inputs.merge_format }}" != "default" ]; then
            MERGE="--merge-output-format ${{ github.event.inputs.merge_format }}"
          fi
          echo "merge=${MERGE}" >> "$GITHUB_OUTPUT"

      # ------------------------------------------------------------
      #  ویدیو: اجرای دانلود
      # ------------------------------------------------------------
      - name: 📥 دانلود ویدیو
        if: github.event.inputs.download_mode == 'video'
        shell: bash
        run: |
          DST="VIDEO"
          mkdir -p "$DST"

          if [ "${{ github.event.inputs.list_extractors }}" = "true" ]; then
            yt-dlp --list-extractors > "$DST/supported_sites.json"
            echo "✅ لیست سایت‌های پشتیبانی‌شده در VIDEO/supported_sites.json ذخیره شد"
            exit 0
          fi

          if [ "${{ github.event.inputs.list_formats }}" = "true" ]; then
            yt-dlp -F "${{ github.event.inputs.url }}" > "$DST/available_formats.txt"
            echo "✅ فرمت‌های موجود در VIDEO/available_formats.txt ذخیره شد"
            exit 0
          fi

          TEMPLATE="$DST/%(title)s/${{ github.event.inputs.filename_template }}"

          EXTRA=()
          [ "${{ github.event.inputs.write_info_json }}" = "true" ] && EXTRA+=("--write-info-json")
          [ "${{ github.event.inputs.write_description }}" = "true" ] && EXTRA+=("--write-description")
          [ "${{ github.event.inputs.write_all_thumbnails }}" = "true" ] && EXTRA+=("--write-all-thumbnails")

          yt-dlp \
            -f "${{ steps.video-mapper.outputs.format }}" \
            ${{ steps.video-mapper.outputs.merge }} \
            -o "$TEMPLATE" \
            --socket-timeout "${{ github.event.inputs.socket_timeout }}" \
            --retries "${{ github.event.inputs.retries }}" \
            --fragment-retries "${{ github.event.inputs.fragment_retries }}" \
            --file-access-retries "${{ github.event.inputs.file_access_retries }}" \
            "${EXTRA[@]}" \
            "${{ github.event.inputs.url }}"

          echo "✅ دانلود ویدیو با موفقیت انجام شد"

      # ------------------------------------------------------------
      #  صوت: نگاشت کیفیت
      # ------------------------------------------------------------
      - name: 🗺️ نگاشت گزینه‌های صوت
        if: github.event.inputs.download_mode == 'audio'
        id: audio-mapper
        shell: bash
        run: |
          Q="${{ github.event.inputs.audio_quality }}"
          [ "$Q" = "0 (best)" ] && Q="0"
          echo "quality=${Q}" >> "$GITHUB_OUTPUT"
          echo "format=${{ github.event.inputs.audio_format }}" >> "$GITHUB_OUTPUT"

      # ------------------------------------------------------------
      #  صوت: اجرای دانلود
      # ------------------------------------------------------------
      - name: 📥 دانلود صوت
        if: github.event.inputs.download_mode == 'audio'
        shell: bash
        run: |
          DST="AUDIO"
          mkdir -p "$DST"

          if [ "${{ github.event.inputs.list_extractors }}" = "true" ]; then
            yt-dlp --list-extractors > "$DST/supported_sites.json"
            echo "✅ لیست سایت‌های پشتیبانی‌شده در AUDIO/supported_sites.json ذخیره شد"
            exit 0
          fi

          TEMPLATE="$DST/%(title)s/${{ github.event.inputs.filename_template }}"

          EXTRA=("-x"
                 "--audio-format" "${{ steps.audio-mapper.outputs.format }}"
                 "--audio-quality" "${{ steps.audio-mapper.outputs.quality }}")
          [ "${{ github.event.inputs.embed_thumbnail }}" = "true" ] && EXTRA+=("--embed-thumbnail")
          [ "${{ github.event.inputs.embed_metadata }}" = "true" ] && EXTRA+=("--embed-metadata")

          yt-dlp \
            "${EXTRA[@]}" \
            -o "$TEMPLATE" \
            --socket-timeout "${{ github.event.inputs.socket_timeout }}" \
            --retries "${{ github.event.inputs.retries }}" \
            --fragment-retries "${{ github.event.inputs.fragment_retries }}" \
            --file-access-retries "${{ github.event.inputs.file_access_retries }}" \
            "${{ github.event.inputs.url }}"

          echo "✅ دانلود صوت با موفقیت انجام شد"

      # ------------------------------------------------------------
      #  README استاتیک انگلیسی
      # ------------------------------------------------------------
      - name: 📄 ایجاد README انگلیسی
        shell: bash
        run: |
          if [ "${{ github.event.inputs.download_mode }}" = "video" ]; then
            DIR="VIDEO"
          else
            DIR="AUDIO"
          fi
          cat > "$DIR/README.md" << 'EOF'
# 📖 How to Download Media with This Tool

This workflow uses **yt‑dlp**, **FFmpeg** and **aria2** to download
media from YouTube and hundreds of other sites.

### Quick Start
1. Go to the **Actions** tab in this repository.
2. Select the **Media Downloader Pro** workflow.
3. Click **Run workflow**.
4. Choose **video** or **audio** mode.
5. Fill in the URL and desired options.
6. Downloaded files are saved inside `VIDEO/` or `AUDIO/`.

### Common Options
- **Video**: `best`, `1080p (Full HD)`, `MP4`, `MKV`
- **Audio**: `mp3`, `flac`, `m4a`
- **Metadata**: Check the boxes to save `.info.json` or embed metadata.

---
*Powered by yt‑dlp, FFmpeg, aria2, and GitHub Actions.*
EOF

      # ------------------------------------------------------------
      #  README استاتیک فارسی
      # ------------------------------------------------------------
      - name: 📄 ایجاد README فارسی
        shell: bash
        run: |
          if [ "${{ github.event.inputs.download_mode }}" = "video" ]; then
            DIR="VIDEO"
          else
            DIR="AUDIO"
          fi
          cat > "$DIR/README_FA.md" << 'EOF'
# 📖 راهنمای دانلود رسانه با این ابزار

این ابزار از **yt‑dlp**، **FFmpeg** و **aria2** برای دانلود
از یوتیوب و صدها سایت دیگر استفاده می‌کند.

### شروع سریع
1. به تب **Actions** در این مخزن بروید.
2. ورک‌فلو **Media Downloader Pro** را انتخاب کنید.
3. روی **Run workflow** کلیک کنید.
4. حالت **ویدیو** یا **صوت** را انتخاب کنید.
5. نشانی و گزینه‌های مورد نظر را وارد کنید.
6. فایل‌ها در پوشه‌های `VIDEO/` یا `AUDIO/` ذخیره می‌شوند.

### گزینه‌های پرکاربرد
- **ویدیو**: `best`، `1080p (Full HD)`، `MP4`
- **صوت**: `mp3`، `flac`، `m4a`
- **فراداده**: چک‌باکس‌ها را برای ذخیرهٔ فایل اطلاعات یا الصاق متادیتا فعال کنید.

---
*ابزاری بر پایهٔ yt‑dlp، FFmpeg، aria2 و GitHub Actions.*
EOF

      # ------------------------------------------------------------
      #  ذخیره در مخزن
      # ------------------------------------------------------------
      - name: 💾 ذخیره تغییرات در مخزن
        shell: bash
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          if [ "${{ github.event.inputs.download_mode }}" = "video" ]; then
            git add VIDEO/
          else
            git add AUDIO/
          fi
          git commit -m "Add downloaded media and README files" || true
          git push
